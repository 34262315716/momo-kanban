{
  "id": "momo-kanban",
  "name": "陌陌看板",
  "description": "陌陌的任务看板，帮助分解任务、逐步执行、持续追踪",
  "version": "1.0.0",
  "contracts": {
    "hooks": [
      "before_prompt_build",
      "message_received",
      "after_tool_call"
    ],
    "tools": [
      "kanban_add",
      "kanban_list",
      "kanban_do",
      "kanban_done",
      "kanban_update",
      "kanban_delete",
      "kanban_archive",
      "kanban_reset",
      "kanban_template_save",
      "kanban_template_apply",
      "kanban_template_list",
      "kanban_dismiss_reminder",
      "kanban_help",
      "kanban_plan_add",
      "kanban_checklist"
    ]
  },
  "toolMetadata": {
    "kanban_add": { "optional": false },
    "kanban_list": { "optional": false },
    "kanban_do": { "optional": false },
    "kanban_done": { "optional": false },
    "kanban_update": { "optional": false },
    "kanban_delete": { "optional": false },
    "kanban_archive": { "optional": false },
    "kanban_reset": { "optional": false },
    "kanban_template_save": { "optional": false },
    "kanban_template_apply": { "optional": false },
    "kanban_template_list": { "optional": false },
    "kanban_dismiss_reminder": { "optional": false },
    "kanban_help": { "optional": false },
    "kanban_plan_add": { "optional": false },
    "kanban_checklist": { "optional": false }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "dataFile": {
        "type": "string",
        "default": "~/.openclaw/data/kanban.json",
        "description": "看板数据存储文件路径"
      },
      "injectEnabled": {
        "type": "boolean",
        "default": true,
        "description": "是否将看板状态注入到上下文"
      },
      "maxTasks": {
        "type": "number",
        "default": 20,
        "description": "最大任务数量"
      }
    }
  },
  "uiHints": {
    "dataFile": {
      "label": "数据文件路径",
      "placeholder": "~/.openclaw/data/kanban.json"
    },
    "injectEnabled": {
      "label": "启用上下文注入",
      "help": "开启后看板状态会持续显示在对话上下文中"
    },
    "maxTasks": {
      "label": "最大任务数",
      "help": "看板最多容纳的任务数量"
    }
  }
}
